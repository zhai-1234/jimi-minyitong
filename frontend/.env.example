# Dify 服务 API 配置
# 在 Dify 控制台 -> 应用 -> 访问 API 中获取 API 密钥（app- 开头）
VITE_DIFY_API_KEY=app-xxxxxxxxxxxxxxxx

# Dify 服务地址（浏览器实际请求走的地址；开发环境经 Vite 代理转发，避免跨域）
VITE_DIFY_API_BASE=/v1

# 开发代理指向的 Dify 服务器地址（Dify 默认 Nginx 端口为 80）
VITE_DIFY_PROXY_TARGET=http://localhost

# 可选：将每轮问答上报到 Spring Boot 后端落库（默认关闭）
VITE_BACKEND_ENABLED=false
VITE_BACKEND_API_BASE=/api
# 开发代理指向的后端地址
VITE_BACKEND_PROXY_TARGET=http://localhost:8081

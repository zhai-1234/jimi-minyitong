sys.files#}}\n输出必须纯粹，并且符合＜示例>的格式，不包含其他解\n释内容。\n至少拆解为4到6个子问题。\n生成的问题必须与{{#1761561558854.output#}}有关"}, "vision": {"enabled": false}, "context": {"enabled": false, "variable_selector": []}, "selected": false, "prompt_template": [{"id": "e6f9be78-63b4-43ad-bc1b-0d9bfceea49c", "role": "system", "text": "你是社会救助政策问答系统的检索词生成器。\n任务：把用户问题拆解为 3 个用于知识库检索的简短查询词，覆盖问题的不同方面。\n要求：\n- 只输出 3 个查询，使用英文逗号分隔，不要编号、引号、换行或任何解释。\n- 每个查询 6-20 个汉字。\n- 若用户上传了文件，可结合文件内容：{{#1761561558854.output#}}\n示例：\n输入：如何申请低保\n输出：低保申请条件,低保申请材料,低保办理流程\n"}], "reasoning_format": "tagged"}, "type": "custom", "width": 241, "height": 87, "position": {"x": 887.4285714285713, "y": 305.5}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "positionAbsolute": {"x": 887.4285714285713, "y": 305.5}}, {"id": "1763273157378", "data": {"code": "def main(input_str: str, user_query: str, user_files: list = None) -> dict:\n    items = []\n    seen = set()\n    if input_str:\n        s = input_str.strip().strip('\"').strip('“').strip('”')\n        text = s.replace('，', ',').replace('、', ',').replace('；', ',').replace(';', ',')\n        for line in text.splitlines():\n            for part in line.split(','):\n                q = part.strip().strip('\"').strip('“').strip('”')\n                if q and q not in seen:\n                    seen.add(q)\n                    items.append(q)\n                    if len(items) >= 4:\n                        break\n            if len(items) >= 4:\n                break\n    base = (user_query or '').strip()\n    joined = '；'.join(items)\n    if user_files and joined:\n        query = (base + '；' + joined) if base else joined\n    else:\n        query = base or joined\n    return {'result': items, 'query': query}\n", "type": "code", "title": "数组", "outputs": {"result": {"type": "array[string]", "children": null}, "query": {"type": "string", "children": null}}, "selected": false, "variables": [{"variable": "input_str", "value_type": "string", "value_selector": ["1763271273271", "text"]}, {"variable": "user_query", "value_type": "string", "value_selector": ["sys", "query"]}, {"variable": "user_files", "value_type": "array[file]", "value_selector": ["sys", "files"]}], "code_language": "python3"}, "type": "custom", "width": 241, "height": 51, "position": {"x": 1197, "y": 305.5}, "selected": true, "sourcePosition": "right", "targetPosition": "left", "positionAbsolute": {"x": 1197, "y": 305.5}}, {"id": "1763273371556", "data": {"type": "knowledge-retrieval", "title": "知识检索", "isInLoop": false, "selected": false, "dataset_ids": ["452cebfd-71ca-42ff-b64d-3013eb8bcbb1"], "iteration_id": "1763273358652", "isInIteration": true, "retrieval_mode": "multiple", "query_variable_selector": ["1763273157378", "query"], "multiple_retrieval_config": {"top_k": 4, "reranking_mode": "reranking_model", "reranking_model": {"model": "bce-reranker-base", "provider": "langgenius/wenxin/wenxin"}, "reranking_enable": false}}, "type": "custom", "width": 241, "height": 51, "zIndex": 1002, "parentId": null, "position": {"x": 1900, "y": 300}, "selected": false, "sourcePosition": "right", "targetPosition": "left", "positionAbsolute": {"x": 1900, "y": 300}}], "viewport": {"x": -602.4963879798588, "y": -50.04432178595641, "zoom": 1.0080862538197122}}